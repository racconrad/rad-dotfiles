#!/bin/sh
# Raise playing MPRIS application, otherwise first available player.
for p in $(playerctl -l 2>/dev/null); do
    [ "$p" = "playerctld" ] && continue
    if [ "$(playerctl status -p "$p" 2>/dev/null)" = "Playing" ]; then
        busctl --user call "org.mpris.MediaPlayer2.$p" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2 Raise >/dev/null 2>&1 && exit 0
    fi
done
for p in $(playerctl -l 2>/dev/null); do
    [ "$p" = "playerctld" ] && continue
    busctl --user call "org.mpris.MediaPlayer2.$p" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2 Raise >/dev/null 2>&1 && exit 0
done
exit 1
