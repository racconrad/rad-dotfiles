#!/usr/bin/env python3
"""Raise a playing MPRIS application, otherwise the first available player."""
import sys
from gi.repository import Gio, GLib


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    names = bus.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus',
                         'org.freedesktop.DBus', 'ListNames', None,
                         GLib.VariantType('(as)'), Gio.DBusCallFlags.NONE, 3000, None).unpack()[0]
    players = []
    for name in names:
        if not name.startswith('org.mpris.MediaPlayer2.') or name.endswith('.playerctld'):
            continue
        try:
            state = bus.call_sync(name, '/org/mpris/MediaPlayer2', 'org.freedesktop.DBus.Properties',
                'Get', GLib.Variant('(ss)', ('org.mpris.MediaPlayer2.Player', 'PlaybackStatus')),
                None, Gio.DBusCallFlags.NONE, 1500, None).unpack()[0]
            players.append((state != 'Playing', name))
        except GLib.Error:
            pass
    for _, name in sorted(players):
        try:
            bus.call_sync(name, '/org/mpris/MediaPlayer2', 'org.mpris.MediaPlayer2',
                          'Raise', None, None, Gio.DBusCallFlags.NONE, 1500, None)
            return 0
        except GLib.Error:
            pass
    return 1


if __name__ == '__main__':
    try:
        sys.exit(main())
    except GLib.Error:
        sys.exit(1)
