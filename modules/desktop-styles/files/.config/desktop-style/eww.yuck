(deflisten ui :initial "{\"catalog\": {\"modern\": {\"id\": \"modern\", \"icon\": \"view-grid-symbolic\", \"widget_frame\": \"none\", \"name\": \"Default\", \"detail\": \"Clean, rounded surfaces\", \"font\": \"Inter\", \"radius\": 14, \"border\": 0, \"alpha\": 1, \"skin\": \"minimal\", \"position\": \"bottom\", \"continuous\": false, \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/modern.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/modern-colors.svg\", \"count\": 6}, \"glass\": {\"id\": \"glass\", \"icon\": \"view-reveal-symbolic\", \"widget_frame\": \"none\", \"name\": \"Transparent\", \"detail\": \"Translucent surfaces\", \"font\": \"Inter\", \"radius\": 20, \"border\": 1, \"alpha\": 0.88, \"skin\": \"glass\", \"position\": \"bottom\", \"continuous\": false, \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/glass.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/glass-colors.svg\", \"count\": 6}, \"terminal\": {\"id\": \"terminal\", \"icon\": \"utilities-terminal-symbolic\", \"widget_frame\": \"terminal\", \"name\": \"Classic\", \"detail\": \"Monospaced type and fine borders\", \"font\": \"JetBrainsMono Nerd Font Mono\", \"radius\": 0, \"border\": 1, \"alpha\": 1, \"skin\": \"terminal\", \"position\": \"bottom\", \"continuous\": false, \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/terminal.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/terminal-colors.svg\", \"count\": 6}, \"monochrome\": {\"id\": \"monochrome\", \"icon\": \"format-text-code-symbolic\", \"widget_frame\": \"none\", \"name\": \"Mono\", \"detail\": \"Two colors from your wallpaper\", \"font\": \"JetBrainsMono Nerd Font Mono\", \"radius\": 0, \"border\": 1, \"alpha\": 1, \"skin\": \"monochrome\", \"position\": \"bottom\", \"continuous\": false, \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/monochrome.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/monochrome-colors.svg\", \"count\": 2}, \"retro\": {\"id\": \"retro\", \"icon\": \"applications-games-symbolic\", \"widget_frame\": \"retro\", \"name\": \"Retro\", \"detail\": \"Pixel type and a 16-color palette\", \"font\": \"Silkscreen\", \"radius\": 0, \"border\": 2, \"alpha\": 1, \"skin\": \"pixel\", \"position\": \"bottom\", \"continuous\": false, \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/retro.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/retro-colors.svg\", \"count\": 16}, \"ascii\": {\"id\": \"ascii\", \"icon\": \"format-text-code-symbolic\", \"widget_frame\": \"ascii\", \"name\": \"Night\", \"detail\": \"Navy, ivory, coral and cyan\", \"font\": \"JetBrainsMono Nerd Font Mono\", \"radius\": 0, \"border\": 1, \"alpha\": 1, \"skin\": \"ascii\", \"position\": \"bottom\", \"continuous\": false, \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/ascii.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/ascii-colors.svg\", \"count\": 5}}, \"choices\": [{\"id\": \"modern\", \"icon\": \"view-grid-symbolic\", \"widget_frame\": \"none\", \"name\": \"Default\", \"detail\": \"Clean, rounded surfaces\", \"font\": \"Inter\", \"radius\": 14, \"border\": 0, \"alpha\": 1, \"skin\": \"minimal\", \"position\": \"bottom\", \"continuous\": false, \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/modern.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/modern-colors.svg\", \"count\": 6}, {\"id\": \"glass\", \"icon\": \"view-reveal-symbolic\", \"widget_frame\": \"none\", \"name\": \"Transparent\", \"detail\": \"Translucent surfaces\", \"font\": \"Inter\", \"radius\": 20, \"border\": 1, \"alpha\": 0.88, \"skin\": \"glass\", \"position\": \"bottom\", \"continuous\": false, \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/glass.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/glass-colors.svg\", \"count\": 6}, {\"id\": \"terminal\", \"icon\": \"utilities-terminal-symbolic\", \"widget_frame\": \"terminal\", \"name\": \"Classic\", \"detail\": \"Monospaced type and fine borders\", \"font\": \"JetBrainsMono Nerd Font Mono\", \"radius\": 0, \"border\": 1, \"alpha\": 1, \"skin\": \"terminal\", \"position\": \"bottom\", \"continuous\": false, \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/terminal.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/terminal-colors.svg\", \"count\": 6}, {\"id\": \"monochrome\", \"icon\": \"format-text-code-symbolic\", \"widget_frame\": \"none\", \"name\": \"Mono\", \"detail\": \"Two colors from your wallpaper\", \"font\": \"JetBrainsMono Nerd Font Mono\", \"radius\": 0, \"border\": 1, \"alpha\": 1, \"skin\": \"monochrome\", \"position\": \"bottom\", \"continuous\": false, \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/monochrome.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/monochrome-colors.svg\", \"count\": 2}, {\"id\": \"retro\", \"icon\": \"applications-games-symbolic\", \"widget_frame\": \"retro\", \"name\": \"Retro\", \"detail\": \"Pixel type and a 16-color palette\", \"font\": \"Silkscreen\", \"radius\": 0, \"border\": 2, \"alpha\": 1, \"skin\": \"pixel\", \"position\": \"bottom\", \"continuous\": false, \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/retro.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/retro-colors.svg\", \"count\": 16}, {\"id\": \"ascii\", \"icon\": \"format-text-code-symbolic\", \"widget_frame\": \"ascii\", \"name\": \"Night\", \"detail\": \"Navy, ivory, coral and cyan\", \"font\": \"JetBrainsMono Nerd Font Mono\", \"radius\": 0, \"border\": 1, \"alpha\": 1, \"skin\": \"ascii\", \"position\": \"bottom\", \"continuous\": false, \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/ascii.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/ascii-colors.svg\", \"count\": 5}], \"selected\": \"modern\", \"current\": \"original\", \"busy\": false, \"notice\": \"\", \"frame\": \"auto\", \"frames\": [[{\"id\": \"auto\", \"name\": \"Follow theme\", \"icon\": \"insert-link-symbolic\"}, {\"id\": \"none\", \"name\": \"No frame\", \"icon\": \"window-minimize-symbolic\"}, {\"id\": \"monochrome\", \"name\": \"Mono\", \"icon\": \"format-text-code-symbolic\"}, {\"id\": \"terminal\", \"name\": \"Classic\", \"icon\": \"utilities-terminal-symbolic\"}, {\"id\": \"retro\", \"name\": \"Retro\", \"icon\": \"applications-games-symbolic\"}], [{\"id\": \"future\", \"name\": \"Future\", \"icon\": \"applications-engineering-symbolic\"}, {\"id\": \"glass\", \"name\": \"Transparent\", \"icon\": \"view-reveal-symbolic\"}, {\"id\": \"modern\", \"name\": \"Default\", \"icon\": \"view-grid-symbolic\"}, {\"id\": \"gnome\", \"name\": \"Rounded\", \"icon\": \"preferences-desktop-symbolic\"}, {\"id\": \"windows\", \"name\": \"Compact\", \"icon\": \"preferences-system-windows-symbolic\"}], [{\"id\": \"ascii\", \"name\": \"Night\", \"icon\": \"format-text-code-symbolic\"}]], \"motion\": false, \"compact_motion\": false, \"bar\": {\"position\": \"bottom\", \"layout\": \"islands\"}, \"extra\": \"\", \"extra_page\": \"bar\", \"frames_loaded\": false, \"sddm_busy\": false}" "~/.local/bin/desktop-style watch")
(defvar selector_closing false)
(defvar selector_prewarm false)

(defwidget style-main []
  (box :class "selector-main" :orientation "v" :space-evenly false :spacing 18 :width 720 :hexpand true
    (label :class "initial-hidden" :visible false :text selector_prewarm)
    (box :class "header" :space-evenly false :spacing 12
      (box :class "style-emblem" (image :icon "preferences-desktop-theme-symbolic" :icon-size "large-toolbar"))
      (label :class "heading" :hexpand true :xalign 0 :text "Desktop style")
      (button :class "close" :tooltip "Close · Esc" :onclick "~/.local/bin/desktop-style close"
        (image :icon "window-close-symbolic" :icon-size "button")))
    (box :space-evenly false :spacing 22
      (box :class "style-list" :orientation "v" :space-evenly false :spacing 6 :width 196
        (for choice in {ui.choices}
          (button :class "style-option theme-choice ${ui.selected == choice.id ? 'selected' : ''}"
            :active {!ui.busy} :tooltip "${choice.name} · ${choice.detail}" :onclick "~/.local/bin/desktop-style select ${choice.id}" :timeout "3s"
            (box :space-evenly false :spacing 12
              (box :class "choice-icon" (image :icon {choice.icon ?: 'preferences-desktop-theme-symbolic'} :icon-size "large-toolbar"))
              (label :class "option-name" :xalign 0 :hexpand true :text {choice.name})
              (image :visible {ui.current == choice.id} :tooltip "Active style" :icon "emblem-ok-symbolic" :icon-size "menu")))))
      (box :class "preview-column" :orientation "v" :space-evenly false :spacing 12
        (box :space-evenly false :spacing 8
          (label :class "preview-title" :hexpand true :xalign 0 :text {ui.catalog[ui.selected].name})
          (button :class "frame-toggle bar-toggle ${(ui.extra ?: '') == 'bar' ? 'selected' : ''}" :tooltip "Bar position and layout"
            :onclick "~/.local/bin/desktop-style extra bar"
            (image :icon "preferences-desktop-display-symbolic" :icon-size "button"))
          (button :class "frame-toggle frames-toggle ${(ui.extra ?: '') == 'frames' ? 'selected' : ''}" :tooltip "Widget frames · saved per theme"
            :onclick "~/.local/bin/desktop-style extra frames"
            (image :icon "preferences-system-windows-symbolic" :icon-size "button")))
        (image :class "preview-stack" :path {ui.catalog[ui.selected].preview} :image-width 440 :image-height 280)
        (image :path {ui.catalog[ui.selected].swatches} :image-width 440 :image-height 20)
      ))
    (box :class "footer" :space-evenly false :spacing 12
      (button :class "restore" :visible {ui.selected == 'ascii'} :active {!ui.busy}
        :tooltip "Use Night wallpaper" :onclick "~/.local/bin/desktop-style background ascii" :timeout "100s"
        (image :icon "preferences-desktop-wallpaper-symbolic" :icon-size "button"))
      (button :class "restore" :tooltip "Restore original appearance" :active {!ui.busy && ui.current != 'original'} :onclick "~/.local/bin/desktop-style reset" :timeout "45s"
        (image :icon "edit-undo-symbolic" :icon-size "button"))
      (button :class "restore sddm-apply" :active {!ui.busy && ui.current == ui.selected && ui.current != 'original'}
        :tooltip {ui.current != ui.selected || ui.current == 'original' ? 'Apply a desktop style first' : 'Copy active style to the login screen · requires authentication'}
        :onclick "~/.local/bin/desktop-style sddm" :timeout "360s"
        (box :space-evenly false :spacing 8
          (image :icon "system-lock-screen-symbolic" :icon-size "button")
          (label :text {(ui.sddm_busy ?: false) ? 'Applying…' : 'Apply to SDDM'})))
      (label :class "notice" :hexpand true :wrap true :width 180 :text {ui.notice})
      (button :class "apply ${ui.busy ? 'applying' : ''}" :tooltip {(ui.sddm_busy ?: false) ? 'Updating login screen…' : ui.busy ? 'Applying style…' : ui.current == ui.selected ? 'Active style' : 'Apply style · Ctrl+Enter'}
        :active {!ui.busy && ui.current != ui.selected} :onclick "~/.local/bin/desktop-style apply ${ui.selected}" :timeout "60s"
        (image :icon {ui.busy ? 'process-working-symbolic' : ui.current == ui.selected ? 'emblem-ok-symbolic' : 'object-select-symbolic'} :icon-size "large-toolbar")))))


(defwidget style-bar-options []
(box :class "bar-picker" :orientation "v" :space-evenly false :spacing 8
            (box :space-evenly false :spacing 6
              (label :class "caption" :hexpand true :xalign 0 :text "Position")
              (button :class "style-option ${(ui.bar.position ?: 'bottom') == 'bottom' ? 'selected' : ''}" :active {!ui.busy}
                :onclick "~/.local/bin/desktop-style bar position bottom" :timeout "15s" (label :text "Bottom"))
              (button :class "style-option ${(ui.bar.position ?: 'bottom') == 'top' ? 'selected' : ''}" :active {!ui.busy}
                :onclick "~/.local/bin/desktop-style bar position top" :timeout "15s" (label :text "Top")))
            (box :space-evenly false :spacing 6
              (label :class "caption" :hexpand true :xalign 0 :text "Sides")
              (button :class "style-option ${(ui.bar.position ?: 'bottom') == 'left' ? 'selected' : ''}" :active {!ui.busy}
                :onclick "~/.local/bin/desktop-style bar position left" :timeout "15s" (label :text "Left"))
              (button :class "style-option ${(ui.bar.position ?: 'bottom') == 'right' ? 'selected' : ''}" :active {!ui.busy}
                :onclick "~/.local/bin/desktop-style bar position right" :timeout "15s" (label :text "Right")))
            (box :space-evenly false :spacing 6
              (label :class "caption" :hexpand true :xalign 0 :text "Layout")
              (button :class "style-option ${(ui.bar.layout ?: 'islands') == 'islands' ? 'selected' : ''}" :active {!ui.busy}
                :onclick "~/.local/bin/desktop-style bar layout islands" :timeout "15s" (label :text "Islands"))
              (button :class "style-option ${(ui.bar.layout ?: 'islands') == 'continuous' ? 'selected' : ''}" :active {!ui.busy}
                :onclick "~/.local/bin/desktop-style bar layout continuous" :timeout "15s" (label :text "Full panel")))
            (label :class "caption" :xalign 0 :text "Kept across themes")))

(defwidget style-frame-options []
(box :class "frame-picker" :orientation "v" :space-evenly false :spacing 6
            (for row in {(ui.frames_loaded ?: false) ? (ui.frames ?: []) : []}
              (box :space-evenly true :spacing 6
                (for f in row
                  (button :class "style-option frame-option ${(ui.frame ?: 'auto') == f.id ? 'selected' : ''}"
                    :active {!ui.busy} :tooltip {f.name} :onclick "~/.local/bin/desktop-style frame ${f.id} ${ui.selected}" :timeout "5s"
                    (image :icon {f.icon ?: 'preferences-system-windows-symbolic'} :icon-size "button")))))))

(defwidget style-extras []
  (box :class "selector-extra" :orientation "v" :space-evenly false :spacing 10 :width 260
    (box :class "extra-header" :space-evenly false :spacing 8
      (label :class "extra-title" :hexpand true :xalign 0 :text {(ui.extra_page ?: 'bar') == 'bar' ? 'Bar' : 'Widget frames'})
      (button :class "extra-close" :tooltip "Close options · Esc" :onclick "~/.local/bin/desktop-style extra close"
        (image :icon "window-close-symbolic" :icon-size "button")))
    (stack :class "extra-pages" :selected {(ui.extra_page ?: 'bar') == 'frames' ? 1 : 0} :same-size false
      :transition "slideup"
      (style-bar-options)
      (box :orientation "v" :space-evenly false :spacing 8
        (label :class "caption" :xalign 0 :text "Saved for ${ui.catalog[ui.selected].name}")
        (style-frame-options)))))

(defwidget style-selector []
  (box :class "style-selector style-shell ${ui.motion == true ? 'motion' : 'still'} ${ui.compact_motion == true ? 'compact-motion' : ''} ${selector_closing ? 'closing' : ''}"
    :space-evenly false :spacing 0
    (style-main)
    (revealer :class "extra-revealer" :reveal {(ui.extra ?: '') != ''} :transition "slideright"
      :duration {ui.compact_motion ? '140ms' : '200ms'} :valign "end"
      (scroll :class "extra-scroll" :hscroll false :vscroll true
        (style-extras)))))

(defwindow styles
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "760px" :height "1px" :anchor "center")
  :stacking "overlay" :exclusive false :focusable true :namespace "desktop-style"
  (style-selector))
