(deflisten ui :initial "{\"catalog\": {\"monochrome\": {\"id\": \"monochrome\", \"icon\": \"format-text-code-symbolic\", \"widget_frame\": \"none\", \"name\": \"Monochrome\", \"detail\": \"Two colors from your wallpaper\", \"font\": \"JetBrainsMono Nerd Font Mono\", \"radius\": 0, \"border\": 1, \"alpha\": 1, \"skin\": \"monochrome\", \"position\": \"bottom\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/monochrome.svg\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/monochrome-colors.svg\", \"count\": 2}, \"terminal\": {\"id\": \"terminal\", \"icon\": \"utilities-terminal-symbolic\", \"widget_frame\": \"terminal\", \"name\": \"Terminal\", \"detail\": \"Monospaced type and fine borders\", \"font\": \"JetBrainsMono Nerd Font Mono\", \"radius\": 0, \"border\": 1, \"alpha\": 1, \"skin\": \"terminal\", \"position\": \"top\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/terminal.svg\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/terminal-colors.svg\", \"count\": 6}, \"retro\": {\"id\": \"retro\", \"icon\": \"applications-games-symbolic\", \"widget_frame\": \"retro\", \"name\": \"Retro\", \"detail\": \"Pixel art in 16 colors\", \"font\": \"Silkscreen\", \"radius\": 0, \"border\": 2, \"alpha\": 1, \"skin\": \"pixel\", \"position\": \"bottom\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/retro.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/retro-colors.svg\", \"count\": 16}, \"glass\": {\"id\": \"glass\", \"icon\": \"view-reveal-symbolic\", \"widget_frame\": \"none\", \"name\": \"Glass\", \"detail\": \"Glass and translucent surfaces\", \"font\": \"Inter\", \"radius\": 20, \"border\": 1, \"alpha\": 0.88, \"skin\": \"glass\", \"position\": \"bottom\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/glass.svg\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/glass-colors.svg\", \"count\": 6}, \"modern\": {\"id\": \"modern\", \"icon\": \"view-grid-symbolic\", \"widget_frame\": \"none\", \"name\": \"Modern\", \"detail\": \"Clean surfaces and a soft accent\", \"font\": \"Inter\", \"radius\": 14, \"border\": 0, \"alpha\": 1, \"skin\": \"minimal\", \"position\": \"bottom\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/modern.svg\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/modern-colors.svg\", \"count\": 6}, \"gnome\": {\"id\": \"gnome\", \"icon\": \"preferences-desktop-symbolic\", \"widget_frame\": \"gnome\", \"name\": \"GNOME\", \"detail\": \"Top bar and rounded controls\", \"font\": \"Adwaita Sans\", \"radius\": 16, \"border\": 1, \"alpha\": 1, \"skin\": \"gnome\", \"position\": \"top\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/gnome.svg\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/gnome-colors.svg\", \"count\": 6}, \"windows\": {\"id\": \"windows\", \"icon\": \"preferences-system-windows-symbolic\", \"widget_frame\": \"windows\", \"name\": \"Windows\", \"detail\": \"Continuous bottom bar and compact panels\", \"font\": \"Inter\", \"radius\": 6, \"border\": 1, \"alpha\": 1, \"skin\": \"bento\", \"position\": \"bottom\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/windows.svg\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/windows-colors.svg\", \"count\": 6}}, \"choices\": [{\"id\": \"monochrome\", \"icon\": \"format-text-code-symbolic\", \"widget_frame\": \"none\", \"name\": \"Monochrome\", \"detail\": \"Two colors from your wallpaper\", \"font\": \"JetBrainsMono Nerd Font Mono\", \"radius\": 0, \"border\": 1, \"alpha\": 1, \"skin\": \"monochrome\", \"position\": \"bottom\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/monochrome.svg\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/monochrome-colors.svg\", \"count\": 2}, {\"id\": \"terminal\", \"icon\": \"utilities-terminal-symbolic\", \"widget_frame\": \"terminal\", \"name\": \"Terminal\", \"detail\": \"Monospaced type and fine borders\", \"font\": \"JetBrainsMono Nerd Font Mono\", \"radius\": 0, \"border\": 1, \"alpha\": 1, \"skin\": \"terminal\", \"position\": \"top\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/terminal.svg\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/terminal-colors.svg\", \"count\": 6}, {\"id\": \"retro\", \"icon\": \"applications-games-symbolic\", \"widget_frame\": \"retro\", \"name\": \"Retro\", \"detail\": \"Pixel art in 16 colors\", \"font\": \"Silkscreen\", \"radius\": 0, \"border\": 2, \"alpha\": 1, \"skin\": \"pixel\", \"position\": \"bottom\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/retro.png\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/retro-colors.svg\", \"count\": 16}, {\"id\": \"glass\", \"icon\": \"view-reveal-symbolic\", \"widget_frame\": \"none\", \"name\": \"Glass\", \"detail\": \"Glass and translucent surfaces\", \"font\": \"Inter\", \"radius\": 20, \"border\": 1, \"alpha\": 0.88, \"skin\": \"glass\", \"position\": \"bottom\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/glass.svg\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/glass-colors.svg\", \"count\": 6}, {\"id\": \"modern\", \"icon\": \"view-grid-symbolic\", \"widget_frame\": \"none\", \"name\": \"Modern\", \"detail\": \"Clean surfaces and a soft accent\", \"font\": \"Inter\", \"radius\": 14, \"border\": 0, \"alpha\": 1, \"skin\": \"minimal\", \"position\": \"bottom\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/modern.svg\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/modern-colors.svg\", \"count\": 6}, {\"id\": \"gnome\", \"icon\": \"preferences-desktop-symbolic\", \"widget_frame\": \"gnome\", \"name\": \"GNOME\", \"detail\": \"Top bar and rounded controls\", \"font\": \"Adwaita Sans\", \"radius\": 16, \"border\": 1, \"alpha\": 1, \"skin\": \"gnome\", \"position\": \"top\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/gnome.svg\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/gnome-colors.svg\", \"count\": 6}, {\"id\": \"windows\", \"icon\": \"preferences-system-windows-symbolic\", \"widget_frame\": \"windows\", \"name\": \"Windows\", \"detail\": \"Continuous bottom bar and compact panels\", \"font\": \"Inter\", \"radius\": 6, \"border\": 1, \"alpha\": 1, \"skin\": \"bento\", \"position\": \"bottom\", \"preview\": \"@RDOT_HOME@/.config/desktop-style/previews/windows.svg\", \"swatches\": \"@RDOT_HOME@/.config/desktop-style/previews/windows-colors.svg\", \"count\": 6}], \"selected\": \"modern\", \"current\": \"original\", \"busy\": false, \"notice\": \"\", \"frame\": \"auto\", \"frames\": [[{\"id\": \"auto\", \"name\": \"Follow theme\", \"icon\": \"insert-link-symbolic\"}, {\"id\": \"none\", \"name\": \"No frame\", \"icon\": \"window-minimize-symbolic\"}, {\"id\": \"monochrome\", \"name\": \"Mono\", \"icon\": \"format-text-code-symbolic\"}, {\"id\": \"terminal\", \"name\": \"Terminal\", \"icon\": \"utilities-terminal-symbolic\"}, {\"id\": \"retro\", \"name\": \"Retro\", \"icon\": \"applications-games-symbolic\"}], [{\"id\": \"future\", \"name\": \"Future\", \"icon\": \"applications-engineering-symbolic\"}, {\"id\": \"glass\", \"name\": \"Glass\", \"icon\": \"view-reveal-symbolic\"}, {\"id\": \"modern\", \"name\": \"Modern\", \"icon\": \"view-grid-symbolic\"}, {\"id\": \"gnome\", \"name\": \"GNOME\", \"icon\": \"preferences-desktop-symbolic\"}, {\"id\": \"windows\", \"name\": \"Windows\", \"icon\": \"preferences-system-windows-symbolic\"}]], \"motion\": true, \"compact_motion\": true}" "~/.local/bin/desktop-style watch")
(defvar selector_closing false)
(defvar selector_prewarm false)
(defvar show_frames false)

(defwidget style-selector []
  (box :class "style-selector ${ui.motion == true ? 'motion' : 'still'} ${ui.compact_motion == true ? 'compact-motion' : ''} ${selector_closing ? 'closing' : ''}" :orientation "v" :space-evenly false :spacing 18
    (label :class "initial-hidden" :visible false :text selector_prewarm)
    (box :class "header" :space-evenly false :spacing 12
      (box :class "style-emblem" (image :icon "preferences-desktop-theme-symbolic" :icon-size "large-toolbar"))
      (label :class "heading" :hexpand true :xalign 0 :text "Desktop style")
      (button :class "close" :tooltip "Close · Esc" :onclick "~/.local/bin/desktop-style close"
        (image :icon "window-close-symbolic" :icon-size "button")))
    (box :space-evenly false :spacing 22
      (box :class "style-list" :orientation "v" :space-evenly false :spacing 6 :width 196
        (for choice in {ui.choices}
          (button :class "style-option theme-choice ${ui.selected == choice.id ? 'selected' : ''}"
            :active {!ui.busy} :tooltip "${choice.name} · ${choice.detail}" :onclick "~/.local/bin/desktop-style select ${choice.id}" :timeout "3s"
            (box :space-evenly false :spacing 12
              (box :class "choice-icon" (image :icon {choice.icon ?: 'preferences-desktop-theme-symbolic'} :icon-size "large-toolbar"))
              (label :class "option-name" :xalign 0 :hexpand true :text {choice.name})
              (image :visible {ui.current == choice.id} :tooltip "Active style" :icon "emblem-ok-symbolic" :icon-size "menu")))))
      (box :class "preview-column" :orientation "v" :space-evenly false :spacing 12
        (box :space-evenly false :spacing 8
          (label :class "preview-title" :hexpand true :xalign 0 :text {ui.catalog[ui.selected].name})
          (button :class "frame-toggle ${show_frames ? 'selected' : ''}" :tooltip "Widget frames · saved per theme"
            :onclick "eww --no-daemonize -c $HOME/.config/desktop-style update show_frames=${!show_frames}"
            (image :icon "preferences-system-windows-symbolic" :icon-size "button")))
        (stack :class "preview-stack" :same-size true
          :selected {ui.selected == 'monochrome' ? 0 : ui.selected == 'terminal' ? 1 : ui.selected == 'retro' ? 2 : ui.selected == 'glass' ? 3 : ui.selected == 'modern' ? 4 : ui.selected == 'gnome' ? 5 : 6}
          :transition {ui.motion == true ? "crossfade" : "none"}
          (image :path {ui.catalog.monochrome.preview} :image-width 440 :image-height 280)
          (image :path {ui.catalog.terminal.preview} :image-width 440 :image-height 280)
          (image :path {ui.catalog.retro.preview} :image-width 440 :image-height 280)
          (image :path {ui.catalog.glass.preview} :image-width 440 :image-height 280)
          (image :path {ui.catalog.modern.preview} :image-width 440 :image-height 280)
          (image :path {ui.catalog.gnome.preview} :image-width 440 :image-height 280)
          (image :path {ui.catalog.windows.preview} :image-width 440 :image-height 280))
        (image :path {ui.catalog[ui.selected].swatches} :image-width 440 :image-height 20)
        (revealer :reveal show_frames :transition {ui.motion ? "slidedown" : "none"} :duration "180ms"
          (box :class "frame-picker" :orientation "v" :space-evenly false :spacing 6
            (for row in {ui.frames ?: []}
              (box :space-evenly true :spacing 6
                (for f in row
                  (button :class "style-option frame-option ${(ui.frame ?: 'auto') == f.id ? 'selected' : ''}"
                    :active {!ui.busy} :tooltip {f.name} :onclick "~/.local/bin/desktop-style frame ${f.id} ${ui.selected}" :timeout "5s"
                    (image :icon {f.icon ?: 'preferences-system-windows-symbolic'} :icon-size "button")))))))))
    (box :class "footer" :space-evenly false :spacing 12
      (button :class "restore" :tooltip "Restore original appearance" :active {!ui.busy && ui.current != 'original'} :onclick "~/.local/bin/desktop-style reset" :timeout "45s"
        (image :icon "edit-undo-symbolic" :icon-size "button"))
      (label :class "notice" :hexpand true :wrap true :width 180 :text {ui.notice})
      (button :class "apply ${ui.busy ? 'applying' : ''}" :tooltip {ui.busy ? 'Applying style…' : ui.current == ui.selected ? 'Active style' : 'Apply style · Ctrl+Enter'}
        :active {!ui.busy && ui.current != ui.selected} :onclick "~/.local/bin/desktop-style apply ${ui.selected}" :timeout "60s"
        (image :icon {ui.busy ? 'process-working-symbolic' : ui.current == ui.selected ? 'emblem-ok-symbolic' : 'object-select-symbolic'} :icon-size "large-toolbar")))))

(defwindow styles
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "760px" :height "1px" :anchor "center")
  :stacking "overlay" :exclusive false :focusable true :namespace "desktop-style"
  (style-selector))
