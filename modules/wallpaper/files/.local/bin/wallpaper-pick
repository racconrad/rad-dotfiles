#!/usr/bin/env bash
# Pick a wallpaper from the wallpaper directory with fuzzel (or --random).
set -euo pipefail

custom_dir=""
if [[ -f "$HOME/.config/raccon/wallpaper-dir" ]]; then
  custom_dir="$(tr -d '\r\n' < "$HOME/.config/raccon/wallpaper-dir" 2>/dev/null || true)"
fi

dir="${WALLPAPER_DIR:-${custom_dir:-$HOME/Pictures/Wallpapers}}"
if [[ -n "$custom_dir" && -z "${WALLPAPER_DIR:-}" ]]; then
  dir="$custom_dir"
fi

mapfile -d '' files < <(find "$dir" -maxdepth 1 -type f \
  \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.mp4' -o -iname '*.webm' \) \
  -print0 2>/dev/null | sort -z)

# Without a wallpaper folder (or with --browse) pick any image on disk; nothing has to be moved first.
if [[ "${1:-}" == "--browse" ]] || (( ${#files[@]} == 0 )) && [[ "${1:-}" != "--random" ]]; then
  browse_dir="$HOME/Pictures"
  [[ -d "$dir" ]] && browse_dir="$dir"
  exec rofi -show filebrowser -filebrowser-directory "$browse_dir" \
    -filebrowser-command "$HOME/.local/bin/wallpaper-set"
fi

if (( ${#files[@]} == 0 )); then
  echo "wallpaper-pick: no images in $dir" >&2
  exit 1
fi

if [[ "${1:-}" == "--random" ]]; then
  choice="${files[RANDOM % ${#files[@]}]}"
else
  name="$(for f in "${files[@]}"; do basename -- "$f"; done \
    | fuzzel --dmenu --prompt "wallpaper  " --width 50)" || exit 0
  [[ -n "$name" ]] || exit 0
  choice="$dir/$name"
fi

exec "$HOME/.local/bin/wallpaper-set" "$choice"
