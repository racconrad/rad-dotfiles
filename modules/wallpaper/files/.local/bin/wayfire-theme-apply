#!/usr/bin/env bash
# Rewrite the themed color keys of ~/.config/wayfire.ini from the matugen
# palette (~/.config/matugen/out/wayfire-colors.sh). Only the listed
# section/key pairs are touched; Wayfire reloads the file automatically.
set -euo pipefail

config_root="${XDG_CONFIG_HOME:-$HOME/.config}"
ini="${WAYFIRE_CONFIG_FILE:-$config_root/wayfire.ini}"
layered=false
if [[ "$ini" == "$config_root/wayfire.ini" && -f "$config_root/wayfire/raccon.ini" ]]; then
  ini="$config_root/wayfire/raccon.ini"
  layered=true
fi
palette="$HOME/.config/matugen/out/wayfire-colors.sh"

[[ -f "$ini" ]] || { echo "wayfire-theme-apply: $ini not found" >&2; exit 1; }
[[ -f "$palette" ]] || { echo "wayfire-theme-apply: no palette yet ($palette)" >&2; exit 0; }

# shellcheck source=/dev/null
source "$palette"

: "${WF_PRIMARY:?}" "${WF_ON_PRIMARY:?}" "${WF_SURFACE:?}" \
  "${WF_SURFACE_CONTAINER:?}" "${WF_ON_SURFACE:?}" \
  "${WF_ON_SURFACE_VARIANT:?}" "${WF_OUTLINE_VARIANT:?}"

c() { printf '\\#%sff' "$1"; }
ca() { printf '\\#%s%s' "$1" "$2"; }

# section|key|value
map="$(cat <<MAP
core|background_color|$(c "$WF_SURFACE")
decoration|active_color|$(c "$WF_SURFACE_CONTAINER")
decoration|inactive_color|$(c "$WF_SURFACE")
decoration|font_color|$(c "$WF_ON_SURFACE")
pixdecor|fg_color|$(c "$WF_PRIMARY")
pixdecor|bg_color|$(c "$WF_OUTLINE_VARIANT")
pixdecor|effect_color|$(ca "$WF_PRIMARY" 99)
winshadows|glow_color|$(ca "$WF_PRIMARY" cc)
pixdecor|fg_text_color|$(c "$WF_ON_PRIMARY")
pixdecor|bg_text_color|$(c "$WF_ON_SURFACE_VARIANT")
simple-tile|preview_base_color|$(ca "$WF_PRIMARY" 33)
simple-tile|preview_base_border|$(ca "$WF_PRIMARY" cc)
move|preview_base_color|$(ca "$WF_PRIMARY" 33)
move|preview_base_border|$(ca "$WF_PRIMARY" cc)
vswitch|background|$(c "$WF_SURFACE")
expo|background|$(c "$WF_SURFACE")
scale|bg_color|$(ca "$WF_SURFACE_CONTAINER" e6)
scale|text_color|$(c "$WF_ON_SURFACE")
MAP
)"

tmp="$(mktemp)"
trap 'rm -f -- "$tmp"' EXIT

MAP="$map" awk '
BEGIN {
  n = split(ENVIRON["MAP"], lines, "\n")
  for (i = 1; i <= n; i++) {
    if (lines[i] == "") continue
    split(lines[i], f, "|")
    val[f[1] SUBSEP f[2]] = f[3]
  }
  section = ""
}
/^[[:space:]]*\[[^]]+\][[:space:]]*$/ {
  s = $0
  gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", s)
  section = s
  print
  next
}
{
  line = $0
  if (match(line, /^[[:space:]]*[A-Za-z0-9_.-]+[[:space:]]*=/)) {
    key = substr(line, RSTART, RLENGTH)
    sub(/=$/, "", key)
    gsub(/[[:space:]]/, "", key)
    if ((section SUBSEP key) in val) {
      print key " = " val[section SUBSEP key]
      next
    }
  }
  print line
}
' "$ini" > "$tmp"

# Only write when something changed; keep the inode (cat >) for inotify.
if ! cmp -s -- "$tmp" "$ini"; then
  cat -- "$tmp" > "$ini"
fi

if $layered; then
  "$HOME/.local/bin/wayfire-config" sync
fi

if [[ -z "${WAYFIRE_CONFIG_FILE:-}" || "${WAYFIRE_CONFIG_FILE}" == "$config_root/wayfire.ini" ]]; then
  canvas_conf="${WF_CANVAS_CONF:-$config_root/wayfire/canvas.conf}"
  if [[ -f "$canvas_conf" ]]; then
    canvas_map="$(cat <<CMAP
hud_background|$(ca "$WF_SURFACE_CONTAINER" e6)
hud_foreground|$(c "$WF_ON_SURFACE")
hud_accent|$(c "$WF_PRIMARY")
hud_border_color|$(ca "$WF_OUTLINE_VARIANT" 66)
background_dot_color|$(ca "$WF_PRIMARY" 44)
CMAP
)"
    tmp_canvas="$(mktemp)"
    CMAP="$canvas_map" awk '
    BEGIN {
      n = split(ENVIRON["CMAP"], lines, "\n")
      for (i = 1; i <= n; i++) {
        if (lines[i] == "") continue
        split(lines[i], f, "|")
        order[++m] = f[1]
        cval[f[1]] = f[2]
      }
    }
    {
      line = $0
      stripped = line
      sub(/^[[:space:]]*#[[:space:]]*/, "", stripped)
      if (match(stripped, /^[A-Za-z0-9_]+[[:space:]]*=/)) {
        key = substr(stripped, RSTART, RLENGTH)
        sub(/=$/, "", key)
        gsub(/[[:space:]]/, "", key)
        if (key in cval) {
          print key " = " cval[key]
          seen[key] = 1
          next
        }
      }
      print line
    }
    END {
      for (i = 1; i <= m; i++) {
        key = order[i]
        if (!(key in seen)) {
          print key " = " cval[key]
        }
      }
    }
    ' "$canvas_conf" > "$tmp_canvas"
    if ! cmp -s -- "$tmp_canvas" "$canvas_conf"; then
      cat -- "$tmp_canvas" > "$canvas_conf"
    fi
    rm -f -- "$tmp_canvas"
  fi

  canvas_tool=""
  if [[ -x "$HOME/.local/bin/raccon-canvas-mode" ]]; then
    canvas_tool="$HOME/.local/bin/raccon-canvas-mode"
  elif [[ -x "$HOME/.local/bin/wf-canvas-mode" ]]; then
    canvas_tool="$HOME/.local/bin/wf-canvas-mode"
  fi
  if [[ -n "$canvas_tool" ]] && [[ "$("$canvas_tool" status 2>/dev/null || true)" == "canvas" ]]; then
    "$canvas_tool" refresh >/dev/null 2>&1 || true
  fi
fi
