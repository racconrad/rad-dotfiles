<?xml version="1.0"?>
<wayfire>
  <plugin name="snap-tiling">
    <_short>Snap Layouts</_short>
    <_long>Choose a window zone by keyboard or pointer, with reversible placement.</_long>
    <category>Window Management</category>
    <option name="gap" type="int"><_short>Window gap</_short><default>10</default><min>0</min><max>100</max></option>
    <option name="toggle" type="key"><_short>Choose a window zone</_short><default>&lt;super&gt; KEY_Z</default></option>
    <option name="detach" type="key"><_short>Restore the previous window geometry</_short><default>&lt;super&gt; &lt;shift&gt; KEY_SPACE</default></option>
  </plugin>
</wayfire>
