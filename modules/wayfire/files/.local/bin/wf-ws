#!/usr/bin/env python3
"""Workspace switching for a 3x3 tiled grid (1-9) plus a floating desktop (10).

Workspace 10 lives in its own Wayfire workspace set (wset 2); windows there are
pulled out of simple-tile so it behaves like a normal floating desktop.

usage: wf-ws goto  1..10      switch to workspace N
       wf-ws send  1..10      send the focused window to workspace N (and follow it)
       wf-ws float VIEW_ID    untile a view (used by wf-focus-fx for wset 2)
"""
import json
import os
import socket
import struct
import sys
import time

GRID_W = 3
TILED_WSET = 1
FLOAT_WSET = 2


class IPC:
    def __init__(self):
        path = os.environ.get("WAYFIRE_SOCKET")
        if not path:
            run = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
            path = os.path.join(run, next(f for f in os.listdir(run) if f.startswith("wayfire-") and f.endswith(".socket")))
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.connect(path)

    def _recv(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("wayfire socket closed")
            buf += chunk
        return buf

    def call(self, method, data=None):
        msg = json.dumps({"method": method, "data": data or {}}).encode()
        self.sock.sendall(struct.pack("<I", len(msg)) + msg)
        (length,) = struct.unpack("<I", self._recv(4))
        return json.loads(self._recv(length))


def focused_output(ipc):
    return ipc.call("window-rules/get-focused-output")["info"]


def ws_xy(n):
    return (n - 1) % GRID_W, (n - 1) // GRID_W


def set_wset(ipc, out, index):
    if out["wset-index"] != index:
        ipc.call("wsets/set-output-wset", {"output-id": out["id"], "wset-index": index})


def goto(ipc, n):
    out = focused_output(ipc)
    if n == 10:
        set_wset(ipc, out, FLOAT_WSET)
        ipc.call("vswitch/set-workspace", {"x": 0, "y": 0, "output-id": out["id"]})
        return
    set_wset(ipc, out, TILED_WSET)
    x, y = ws_xy(n)
    ipc.call("vswitch/set-workspace", {"x": x, "y": y, "output-id": out["id"]})


def remove_from_layout(node, vid):
    key = next((k for k in node if k.endswith("split")), None)
    if key is None:
        return None if node.get("view-id") == vid else node
    node[key] = [c for c in (remove_from_layout(c, vid) for c in node[key]) if c]
    return node


def strip(node):
    node.pop("geometry", None)
    if "percent" in node:
        node["weight"] = node.pop("percent")
    for key in ("vertical-split", "horizontal-split"):
        for child in node.get(key, []):
            strip(child)
    return node


def float_view(ipc, vid):
    info = ipc.call("window-rules/view-info", {"id": vid}).get("info")
    if not info or info.get("role") != "toplevel":
        return
    wset = info.get("wset-index")
    out = ipc.call("window-rules/output-info", {"id": info["output-id"]})
    og = out.get("geometry", {"width": 1920, "height": 1080})
    for ws_x in range(GRID_W):
        for ws_y in range(GRID_W):
            ws = {"x": ws_x, "y": ws_y}
            layout = ipc.call("simple-tile/get-layout", {"wset-index": wset, "workspace": ws}).get("layout")
            if not layout:
                continue
            before = json.dumps(layout)
            pruned = remove_from_layout(layout, vid)
            if pruned is not None and json.dumps(pruned) != before:
                ipc.call("simple-tile/set-layout", {"wset-index": wset, "workspace": ws, "layout": strip(pruned)})
    # Center it at a comfortable size, like a normal desktop window.
    w, h = int(og["width"] * 0.6), int(og["height"] * 0.65)
    ipc.call("window-rules/configure-view", {
        "id": vid,
        "tiled-edges": 0,
        "geometry": {"x": (og["width"] - w) // 2, "y": (og["height"] - h) // 2, "width": w, "height": h},
    })


def send(ipc, n):
    view = ipc.call("window-rules/get-focused-view").get("info")
    if not view or view.get("role") != "toplevel":
        return
    vid = view["id"]
    if n == 10:
        if view.get("wset-index") != FLOAT_WSET:
            ipc.call("wsets/send-view-to-wset", {"view-id": vid, "wset-index": FLOAT_WSET})
        goto(ipc, 10)
        time.sleep(0.05)
        float_view(ipc, vid)
    else:
        if view.get("wset-index") != TILED_WSET:
            ipc.call("wsets/send-view-to-wset", {"view-id": vid, "wset-index": TILED_WSET})
        x, y = ws_xy(n)
        ipc.call("vswitch/send-view", {"view-id": vid, "x": x, "y": y, "output-id": view.get("output-id")})
        goto(ipc, n)
    ipc.call("window-rules/focus-view", {"id": vid})


def main(argv):
    if len(argv) != 2 or argv[0] not in ("goto", "send", "float"):
        print(__doc__.strip(), file=sys.stderr)
        return 1
    ipc = IPC()
    arg = int(argv[1])
    if argv[0] == "float":
        time.sleep(0.25)  # let simple-tile place the freshly mapped view first
        float_view(ipc, arg)
    elif 1 <= arg <= 10:
        (goto if argv[0] == "goto" else send)(ipc, arg)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
