#!/bin/sh
export PATH="$HOME/.local/bin:${PATH:-/usr/bin:/bin}"
user_ini="$HOME/.config/wayfire/user.ini"
if [ -z "${WF_CANVAS_INI:-}" ] && [ -f "$user_ini" ]; then
    export WF_CANVAS_INI="$user_ini"
fi
export WF_CANVAS_ADAPTER="$HOME/.local/bin/canvas-session"

status() {
    wf-canvas-mode status 2>/dev/null || printf '%s\n' unavailable
}

menu_update() {
    eww -c "$HOME/.config/raccon-menu" update "$@" >/dev/null 2>&1 || :
}

refresh_bar() {
    for signal in 8 10 12; do
        pkill "-RTMIN+$signal" -u "$(id -u)" -x waybar 2>/dev/null || :
    done
}

case "${1:-}" in
    normal)
        case "$(status)" in normal|unavailable) exit 0;; *) exit 1;; esac
        ;;
    label)
        case "$(status)" in
            normal) printf '%s\n' 'Tiling';;
            canvas) printf '%s\n' 'Canvas';;
            changing) printf '%s\n' 'Switching…';;
            recover) printf '%s\n' 'Recovery needed';;
        esac
        ;;
    menu)
        if command -v desktop-menu >/dev/null 2>&1; then
            desktop-menu layout
        elif [ -x "$HOME/.local/bin/desktop-menu" ]; then
            "$HOME/.local/bin/desktop-menu" layout
        fi
        menu_update "layout_status=$(status)" "layout_error=" &
        ;;
    on|off|toggle|refresh)
        action="$1"
        [ "$(status)" != changing ] || exit 1
        menu_update "layout_status=changing" "layout_error="
        if output=$(wf-canvas-mode "$action" 2>&1); then
            shortcuts_json=$(python3 "$HOME/.local/lib/raccon_menu/shortcuts.py" 2>/dev/null) || shortcuts_json=
            if [ -n "$shortcuts_json" ]; then
                menu_update "layout_status=$(status)" "shortcuts=$shortcuts_json"
            else
                menu_update "layout_status=$(status)"
            fi
            refresh_bar
            printf '%s\n' "$output"
        else
            menu_update "layout_status=$(status)" "layout_error=$output"
            refresh_bar
            printf '%s\n' "$output" >&2
            exit 1
        fi
        ;;
    *) exec wf-canvas-mode "$@";;
esac
