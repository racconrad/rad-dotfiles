; Floating music card. Own Eww instance: raccon-menu's native module claims every window of its instance.
(defwidget menu-icon [name ?size]
  (image :icon name :icon-size {(size ?: 20) >= 28 ? "dnd" : (size ?: 20) >= 24 ? "large-toolbar" : "button"}))

(deflisten music :initial '{"visible":false,"playing":false,"title":"","artist":"","album":"","player":"","art":"","has_art":false,"time":"","percent":0}'
  "$HOME/.local/bin/desktop-menu music-watch")

(deflisten viz :initial '{"active":false,"level":0,"b0":4,"b1":4,"b2":4,"b3":4,"b4":4,"b5":4,"b6":4,"b7":4,"b8":4,"b9":4,"b10":4,"b11":4}'
  "$HOME/.local/bin/desktop-menu music-viz")

(defvar music_open false)
(defvar card_visible false)
(deflisten desktop :initial '{"style":"original","motion":true}'
  "desktop-menu listen-appearance")

(defwidget music-spectrum []
  (box :class "music-spectrum ${viz.active ? 'active level-' + viz.level : ''}" :space-evenly true :spacing 3 :valign "end" :height 24
    (box :class "spec-bar spec-bar-0" :valign "end" :style "min-height: ${desktop.motion ? (viz.b0 > 24 ? 24 : viz.b0) : 4}px;")
    (box :class "spec-bar spec-bar-1" :valign "end" :style "min-height: ${desktop.motion ? (viz.b1 > 24 ? 24 : viz.b1) : 4}px;")
    (box :class "spec-bar spec-bar-2" :valign "end" :style "min-height: ${desktop.motion ? (viz.b2 > 24 ? 24 : viz.b2) : 4}px;")
    (box :class "spec-bar spec-bar-3" :valign "end" :style "min-height: ${desktop.motion ? (viz.b3 > 24 ? 24 : viz.b3) : 4}px;")
    (box :class "spec-bar spec-bar-4" :valign "end" :style "min-height: ${desktop.motion ? (viz.b4 > 24 ? 24 : viz.b4) : 4}px;")
    (box :class "spec-bar spec-bar-5" :valign "end" :style "min-height: ${desktop.motion ? (viz.b5 > 24 ? 24 : viz.b5) : 4}px;")
    (box :class "spec-bar spec-bar-6" :valign "end" :style "min-height: ${desktop.motion ? (viz.b6 > 24 ? 24 : viz.b6) : 4}px;")
    (box :class "spec-bar spec-bar-7" :valign "end" :style "min-height: ${desktop.motion ? (viz.b7 > 24 ? 24 : viz.b7) : 4}px;")
    (box :class "spec-bar spec-bar-8" :valign "end" :style "min-height: ${desktop.motion ? (viz.b8 > 24 ? 24 : viz.b8) : 4}px;")
    (box :class "spec-bar spec-bar-9" :valign "end" :style "min-height: ${desktop.motion ? (viz.b9 > 24 ? 24 : viz.b9) : 4}px;")
    (box :class "spec-bar spec-bar-10" :valign "end" :style "min-height: ${desktop.motion ? (viz.b10 > 24 ? 24 : viz.b10) : 4}px;")
    (box :class "spec-bar spec-bar-11" :valign "end" :style "min-height: ${desktop.motion ? (viz.b11 > 24 ? 24 : viz.b11) : 4}px;")))

; Draggable music card: artwork, track and spectrum first; pause and close stay faint until hover.
(defwidget menu-music []
  (eventbox :class "music-drag-surface" :visible {music.visible || !card_visible}
    (box :class "panel music-card ${music_open ? 'open' : ''} ${music.playing ? 'playing' : 'paused'} level-${viz.active ? viz.level : 0}" :width 324
      (overlay
        (box :class "music-backdrop ${music.has_art ? 'has-art' : 'empty'}"
          :style {music.has_art ? "background-image: url('${music.art}');" : ""})
        (box :class "music-scrim")
        (box :class "music-content" :orientation "v" :space-evenly false :spacing 8
          (eventbox :onscroll "playerctl position $([ '{}' = 'up' ] && echo 5+ || echo 5-)" :tooltip "Scroll to seek ±5s"
            (progress :class "music-progress" :value {music.percent} :orientation "h"))
          (box :class "music-mid" :space-evenly false :spacing 10 :valign "center"
            (button :class "music-play-btn" :tooltip {music.playing ? "Pause" : "Play"} :timeout "3s"
              :onclick "playerctl play-pause" :valign "center"
              (menu-icon :name {music.playing ? "media-playback-pause-symbolic" : "media-playback-start-symbolic"} :size 16))
            (box :orientation "v" :space-evenly false :spacing 1 :hexpand true :valign "center"
              (label :class "music-title" :xalign 0 :limit-width 19 :text {music.title} :tooltip {music.title})
              (label :class "music-artist muted" :xalign 0 :limit-width 23 :text {music.artist} :tooltip {music.artist}))
            (music-spectrum)))
        (button :class "music-hide" :tooltip "Hide" :timeout "3s" :halign "end" :valign "start"
          :onclick "$HOME/.local/bin/raccon-music close"
          (menu-icon :name "window-close-symbolic" :size 16))))))

(defwindow raccon-music [anchor ?x y]
  :monitor 0
  :geometry (geometry :x {x ?: "4px"} :y y :width "1px" :height "1px" :anchor anchor)
  :stacking "overlay" :exclusive false :focusable false :namespace "raccon-music"
  (box :class "popup music-popup style-${desktop.style ?: 'original'} ${desktop.motion ? 'motion' : 'still'}"
    (label :class "resident-visible" :visible false :text {card_visible ? "true" : "false"})
    (menu-music)))
