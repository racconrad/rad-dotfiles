; Floating music card. Own Eww instance: raccon-menu's native module claims every window of its instance.
(defwidget menu-icon [name ?size]
  (image :icon name :icon-size {(size ?: 20) >= 28 ? "dnd" : (size ?: 20) >= 24 ? "large-toolbar" : "button"}))

(deflisten music :initial '{"visible":false,"playing":false,"title":"","artist":"","art":"","has_art":false,"time":"","percent":0}'
  "python3 $HOME/.local/lib/raccon_menu/music.py")

(defvar music_open false)
(deflisten desktop :initial '{"style":"original","motion":true}'
  "python3 $HOME/.local/lib/raccon_menu/backend.py listen-appearance")

(defwidget music-button [icon tip cmd]
  (button :class "music-button" :tooltip tip :onclick cmd :timeout "3s" (menu-icon :name icon)))

; Compact by default; hover reveals time and track skipping. Waybar's music module reopens it.
(defwidget menu-music []
  (eventbox :visible {music.visible}
    :onhover "eww -c $HOME/.config/raccon-music update music_open=true"
    :onhoverlost "eww -c $HOME/.config/raccon-music update music_open=false"
    (box :class "panel music-card ${music_open ? 'open' : ''}" :orientation "v" :space-evenly false :spacing 8 :width 290
      (box :space-evenly false :spacing 10
        (box :class "music-art ${music.has_art ? '' : 'empty'}" :width 40 :height 40 :valign "center"
          :style {music.has_art ? "background-image: url('${music.art}');" : ""}
          (menu-icon :name "audio-x-generic-symbolic"))
        (box :orientation "v" :space-evenly false :spacing 1 :hexpand true :valign "center"
          (label :class "music-title" :xalign 0 :limit-width 22 :text {music.title} :tooltip {music.title})
          (label :class "music-artist muted" :xalign 0 :limit-width 26 :text {music.artist}))
        (music-button :tip {music.playing ? "Pause" : "Play"} :cmd "playerctl play-pause"
          :icon {music.playing ? "media-playback-pause-symbolic" : "media-playback-start-symbolic"})
        (button :class "music-hide" :tooltip "Hide · click music in Waybar to show" :timeout "3s"
          :onclick "$HOME/.local/bin/raccon-music close"
          (menu-icon :name "window-close-symbolic")))
      (progress :class "music-progress" :value {music.percent} :orientation "h")
      (revealer :reveal music_open :transition "slidedown" :duration "160ms"
        (box :class "music-extra" :space-evenly false :spacing 2
          (label :class "music-time muted" :xalign 0 :hexpand true :text {music.time})
          (music-button :icon "media-skip-backward-symbolic" :tip "Previous" :cmd "playerctl previous")
          (music-button :icon "media-skip-forward-symbolic" :tip "Next" :cmd "playerctl next"))))))

(defwindow raccon-music [anchor y]
  :monitor 0
  :geometry (geometry :x "4px" :y y :width "1px" :height "1px" :anchor anchor)
  :stacking "overlay" :exclusive false :focusable true :namespace "raccon-music"
  (box :class "popup music-popup style-${desktop.style ?: 'original'} ${desktop.motion ? 'motion' : 'still'}" (menu-music)))
