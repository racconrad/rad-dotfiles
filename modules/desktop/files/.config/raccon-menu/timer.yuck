; Focused timer selector: custom text input + quick presets, opens the minimal floating chip.
(deflisten countdown_state :initial '{"state":"idle","duration_seconds":0,"remaining_seconds":0,"time_formatted":"25:00","percent":0,"label":""}'
  "$HOME/.local/bin/countdown --listen")

(defwidget timer-preset [label dur tip]
  (button :class "timer-preset" :tooltip tip :timeout "3s"
    :onclick "$HOME/.local/bin/countdown start ${dur} && $HOME/.local/bin/desktop-menu close"
    (label :text label)))

(defwidget menu-timer []
  (box :class "timer-panel service-content service-full" :orientation "v" :space-evenly false :spacing 10
    (box :class "timer-header-row" :space-evenly false :spacing 8 :valign "center"
      (box :class "timer-dot ${countdown_state.state}" :valign "center")
      (label :class "side-title" :hexpand true :xalign 0 :text "Timer")
      (label :class "timer-live-readout ${countdown_state.state}" :visible {countdown_state.state != 'idle'}
        :text {countdown_state.state == 'ended' ? 'Done!' : countdown_state.time_formatted}))
    (box :class "timer-input-row" :space-evenly false :spacing 6
      (input :class "timer-input" :hexpand true :tooltip "Type e.g. 10 (min), 45s, 1h30m · Press Enter")
      (button :class "timer-go action-toggle" :tooltip "Start timer" :timeout "3s"
        (box :space-evenly false :spacing 5 :halign "center"
          (menu-icon :name "media-playback-start-symbolic" :size 16)
          (label :text "Start"))))
    (box :class "timer-presets" :space-evenly true :spacing 5
      (timer-preset :label "5m" :dur "5m" :tip "5 minutes")
      (timer-preset :label "10m" :dur "10m" :tip "10 minutes")
      (timer-preset :label "15m" :dur "15m" :tip "15 minutes")
      (timer-preset :label "25m" :dur "25m" :tip "25 minutes"))
    (box :class "timer-actions" :visible {countdown_state.state != 'idle'} :space-evenly true :spacing 6
      (button :class "timer-action-btn action-toggle ${countdown_state.state}"
        :tooltip {countdown_state.state == 'paused' ? 'Continue' : countdown_state.state == 'ended' ? 'Dismiss' : 'Pause'}
        :timeout "3s"
        :onclick "$HOME/.local/bin/countdown toggle"
        (box :space-evenly false :spacing 6 :halign "center"
          (menu-icon :name {countdown_state.state == 'paused' ? 'media-playback-start-symbolic' :
                            countdown_state.state == 'ended' ? 'emblem-ok-symbolic' :
                            'media-playback-pause-symbolic'})
          (label :text {countdown_state.state == 'paused' ? 'Continue' :
                        countdown_state.state == 'ended' ? 'OK' : 'Pause'})))
      (button :class "timer-action-btn action-stop" :tooltip "Close floating timer" :timeout "3s"
        :onclick "$HOME/.local/bin/countdown stop"
        (box :space-evenly false :spacing 6 :halign "center"
          (menu-icon :name "window-close-symbolic")
          (label :text "Close"))))))
