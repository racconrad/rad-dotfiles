(deflisten agenda :initial '{"day":1,"month":1,"year":2026,"date":"","error":""}'
  "$HOME/.local/bin/desktop-menu calendar-watch")

(defwidget menu-calendar []
  (box :class "calendar-panel" :orientation "v" :space-evenly false :spacing 4
    (box :class "calendar-header" :space-evenly false :spacing 6
      (label :class "side-title" :xalign 0 :hexpand true :text {agenda.month_title ?: "Calendar"})
      (button :class "calendar-today-btn" :tooltip "Go to today"
        :onclick "$HOME/.local/bin/desktop-menu calendar today" :timeout "3s"
        (menu-icon :name "go-home-symbolic")))
    (box :class "calendar-navigation" :space-evenly false :spacing 4
      (button :class "calendar-nav-prev" :tooltip "Previous month"
        :onclick "$HOME/.local/bin/desktop-menu calendar move -1" :timeout "3s"
        (menu-icon :name "go-previous-symbolic"))
      (label :class "calendar-date-badge" :hexpand true :text {agenda.date})
      (button :class "calendar-nav-next" :tooltip "Next month"
        :onclick "$HOME/.local/bin/desktop-menu calendar move 1" :timeout "3s"
        (menu-icon :name "go-next-symbolic")))
    (box :class "calendar-weekdays" :space-evenly true
      (for day in {agenda.weekdays ?: []} (label :class "calendar-weekday" :text day)))
    (box :class "calendar-grid" :orientation "v" :space-evenly false :spacing 1
      (for week in {agenda.weeks ?: []}
        (box :space-evenly true :spacing 1
          (for day in week
            (button :class "calendar-day ${day.selected ? 'selected' : ''} ${day.today ? 'today' : ''} ${day.other ? 'other-month' : ''}"
              :active {day.iso != ''} :tooltip {day.iso}
              :onclick "$HOME/.local/bin/desktop-menu calendar select ${day.iso}" :timeout "3s"
              (label :text {day.day}))))))))
