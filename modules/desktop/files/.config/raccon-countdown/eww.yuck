; Minimal countdown chip: collapses to time + dot, expands on click for Pause / Continue / Close.
(defvar expanded false)

(deflisten countdown :initial '{"state":"idle","duration_seconds":0,"remaining_seconds":0,"time_formatted":"25:00","percent":0,"label":""}'
  "$HOME/.local/bin/countdown --listen")

(deflisten desktop :initial '{"style":"original","motion":true}'
  "$HOME/.local/bin/desktop-menu listen-appearance")

(defwidget countdown-chip []
  (eventbox :class "card-drag-surface timer-drag-surface" :cursor "pointer"
    (box :class "panel countdown-card ${countdown.state} ${expanded ? 'expanded' : 'compact'}"
         :orientation "v" :space-evenly false :spacing 0
      (progress :class "countdown-progress" :value {countdown.percent} :orientation "h")
      (box :class "countdown-chip-btn" :tooltip "Click: Pause / Close · Drag: Move"
        (box :class "countdown-chip-row" :space-evenly false :spacing 8 :valign "center"
          (box :class "countdown-dot ${countdown.state}" :valign "center")
          (label :class "countdown-time" :xalign 0.5
            :text {countdown.state == "ended" ? "Done!" :
                   countdown.state == "idle" ? "25:00" : countdown.time_formatted})
          (label :class "countdown-state-tag muted" :visible {countdown.state == "paused"} :text "Paused")
          (image :class "countdown-chevron muted"
                 :icon {expanded ? "pan-up-symbolic" : "pan-down-symbolic"}
                 :icon-size "menu")))
      (revealer :reveal {expanded || countdown.state == "ended"}
                :transition {desktop.motion ? "slidedown" : "none"}
                :duration "160ms"
        (box :class "countdown-drawer" :space-evenly true :spacing 6
          (button :class "countdown-btn action-toggle ${countdown.state}"
                  :visible {countdown.state != "ended"}
                  :tooltip {countdown.state == "paused" ? "Continue" : "Pause"}
                  :timeout "3s"
                  :onclick "$HOME/.local/bin/countdown toggle"
            (box :space-evenly false :spacing 5 :halign "center"
              (image :icon {countdown.state == "paused" ? "media-playback-start-symbolic" : "media-playback-pause-symbolic"}
                     :icon-size "menu")
              (label :text {countdown.state == "paused" ? "Continue" : "Pause"})))
          (button :class "countdown-btn action-close"
                  :tooltip {countdown.state == "ended" ? "Dismiss" : "Close timer"}
                  :timeout "3s"
                  :onclick "$HOME/.local/bin/countdown stop"
            (box :space-evenly false :spacing 5 :halign "center"
              (image :icon "window-close-symbolic" :icon-size "menu")
              (label :text "Close"))))))))

(defwindow raccon-countdown [?x ?y]
  :monitor 0
  :geometry (geometry :x {x ?: "0px"} :y {y ?: "18px"} :width "1px" :height "1px" :anchor "top center")
  :stacking "overlay" :exclusive false :focusable false :namespace "raccon-countdown"
  (transform :class "motion-stage" :translate-x "0%" :translate-y "0%"
    (box :class "popup countdown-popup style-${desktop.style ?: 'original'} ${desktop.motion ? 'motion' : 'still'} state-${countdown.state}"
      (countdown-chip))))
