#!/bin/sh
menu="$HOME/.local/bin/desktop-menu"
case "${1:-toggle}" in
    toggle|open|close) exec "$menu" ipc "${1:-toggle}" music ;;
    prepare) exec "$menu" prepare ;;
    refresh) exit 0 ;;
    dock)
        rm -f "${XDG_STATE_HOME:-$HOME/.local/state}/raccon-music/pos" || exit
        "$menu" ipc close music >/dev/null 2>&1
        exec "$menu" ipc open music ;;
    *) echo "usage: raccon-music [toggle|open|close|prepare|dock]" >&2; exit 2 ;;
esac
