#!/usr/bin/env bash
# Toggle (or `close`) the floating music card on the bar's side (own Eww instance).
set -euo pipefail
cfg="$HOME/.config/raccon-music"
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/raccon-music-$(id -u).visibility.lock"
if [[ ${1:-} == prepare ]]; then flock -n 9 || exit 0
else flock -w 3 9 || exit 1; fi
# Flag read by waybar-music: Waybar hides its compact buttons while the card is open.
flag="${XDG_RUNTIME_DIR:-/tmp}/raccon-music.open"
ready="${XDG_RUNTIME_DIR:-$HOME/.cache}/raccon-music.ready"
geometry="${XDG_RUNTIME_DIR:-$HOME/.cache}/raccon-music.geometry"
e() { eww --no-daemonize -c "$cfg" "$@"; }
sync_theme() {
  if [[ -x "$HOME/.local/bin/desktop-menu" ]]; then
    "$HOME/.local/bin/desktop-menu" palette 2>/dev/null && return 0
  fi
  if [[ -f "$HOME/.local/lib/raccon_menu/backend.py" ]]; then
    python3 "$HOME/.local/lib/raccon_menu/backend.py" palette 2>/dev/null || true
  fi
}

bar_geometry() {
  pos=$(grep -oP '^\s*"position"\s*:\s*"\K\w+' "$HOME/.config/waybar/config.jsonc" 2>/dev/null || echo top)
  # Offsets aligned with Waybar, with lateral dock support.
  case "$pos" in
    bottom) anchor="bottom right"; x="8px";  y="4px" ;;
    left)   anchor="top left";     x="64px"; y="8px" ;;
    right)  anchor="top right";    x="64px"; y="8px" ;;
    top|*)  anchor="top right";    x="8px";  y="78px" ;;
  esac
}

if [[ ${1:-} == refresh ]]; then
  sync_theme
  if e ping >/dev/null 2>&1; then e reload; fi
  exit 0
fi
if [[ ${1:-} == dock ]]; then
  rm -f "${XDG_STATE_HOME:-$HOME/.local/state}/raccon-music/pos.ini"
  e close raccon-music >/dev/null 2>&1 || true
  exec "$0"
fi
if [[ ${1:-} == close ]]; then
  rm -f "$flag"
  exec eww --no-daemonize -c "$cfg" update card_visible=false music_open=false
fi
if [[ ${1:-} != prepare ]]; then
  if [[ -f "$flag" ]]; then
    rm -f "$flag"
    if e update card_visible=false music_open=false >/dev/null 2>&1; then
      exit 0
    fi
  fi
  # Fast path when the resident card is already warmed and anchored to the same bar edge.
  bar_geometry
  if [[ -f "$ready" && $(<"$ready") == 1 && -f "$geometry" && $(<"$geometry") == "$anchor:$x:$y" ]]; then
    touch "$flag"
    if e update card_visible=true >/dev/null 2>&1; then
      exit 0
    fi
    rm -f "$flag"
  fi
  if [[ $(e get card_visible 2>/dev/null) == true ]]; then
    rm -f "$flag"
    exec eww --no-daemonize -c "$cfg" update card_visible=false music_open=false
  fi
fi
sync_theme
if [[ -x "$HOME/.local/bin/desktop-menu" ]]; then
  module=$("$HOME/.local/bin/desktop-menu" keyboard-build)
else
  module=$(python3 "$HOME/.local/lib/raccon_menu/keyboard_build.py")
fi
revision=$(stat -c '%y:%s' "$module" 2>/dev/null || echo 0)
key_stamp="$HOME/.cache/raccon-float/music-keyboard.loaded"
if [[ $(cat "$key_stamp" 2>/dev/null || true) != "$revision" ]]; then
  e kill >/dev/null 2>&1 || true
fi
if ! e ping >/dev/null 2>&1; then
  rm -f "$flag" "$ready"
  GTK_MODULES="$module" RACCON_FLOAT_KEYS=1 RACCON_KEYS_COMMAND=raccon-music eww -c "$cfg" daemon 9>&- </dev/null &>/dev/null
  e ping >/dev/null
  printf '%s' "$revision" > "$key_stamp"
fi
bar_geometry
active=$(e active-windows)
if grep -q '^raccon-music:' <<< "$active" && [[ $(cat "$geometry" 2>/dev/null || true) != "$anchor:$x:$y" ]]; then
  e close raccon-music
  active=""
fi
if ! grep -q '^raccon-music:' <<< "$active"; then
  rm -f "$flag" "$ready"
  e update card_visible=false
  e open raccon-music --arg anchor="$anchor" --arg x="$x" --arg y="$y"
  printf '%s' "$anchor:$x:$y" > "$geometry"
fi
if [[ ${1:-} == prepare ]]; then
  if [[ -x "$HOME/.local/bin/desktop-menu" ]]; then
    exec "$HOME/.local/bin/desktop-menu" card-wait raccon-music.ready
  fi
  exec python3 "$HOME/.local/lib/raccon_menu/card_wait.py" raccon-music.ready
fi
touch "$flag"
exec eww --no-daemonize -c "$cfg" update card_visible=true
