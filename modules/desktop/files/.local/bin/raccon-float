#!/usr/bin/env bash
# Large floating widgets (own Eww instance):
#   raccon-float wallpaper|session   toggle the card; it unfolds, then its body flows in
#   raccon-float close                fold and close
#   raccon-float set all|images|videos N  apply wallpaper N of that section (tiles call this)
#   raccon-float run ACTION           session tile: first click arms, second click runs
set -euo pipefail
cfg="$HOME/.config/raccon-float"
lib="$HOME/.local/lib/raccon_menu"
run_dir="${XDG_RUNTIME_DIR:-/tmp}"
session_ready="${XDG_RUNTIME_DIR:-$HOME/.cache}/raccon-float-session.ready"
session_flag="$run_dir/raccon-float-session.open"
wall_flag="$run_dir/raccon-float-wallpaper.open"
e() { eww --no-daemonize -c "$cfg" "$@"; }

who_json() {
  local user host up_sec mins hrs days up=""
  user="${USER:-user}"
  host=$(< /etc/hostname) 2>/dev/null || host="${HOSTNAME:-localhost}"
  read -r up_sec _ < /proc/uptime 2>/dev/null || up_sec=0
  up_sec=${up_sec%%.*}
  days=$((up_sec / 86400)); hrs=$(((up_sec % 86400) / 3600)); mins=$(((up_sec % 3600) / 60))
  (( days > 0 )) && up+="${days}d "
  (( hrs > 0 )) && up+="${hrs}h "
  up+="${mins}m"
  printf '{"user":"%s","host":"%s","uptime":"%s"}' "${user//[\"\\]/}" "${host//[\"\\]/}" "$up"
}

sync_theme() {
  if [[ -x "$HOME/.local/bin/desktop-menu" ]]; then
    "$HOME/.local/bin/desktop-menu" palette && return 0
  fi
  python3 "$lib/backend.py" palette
}

walls_cmd() {
  if [[ -x "$HOME/.local/bin/desktop-menu" ]]; then
    "$HOME/.local/bin/desktop-menu" walls "$@"
  else
    python3 "$lib/walls.py" "$@"
  fi
}

close() {
  local open
  rm -f "$session_flag" "$wall_flag"
  open=$(e active-windows 2>/dev/null | cut -d: -f1) || true
  [[ -n $open ]] || return 0
  if [[ $open == session && $(e get session_visible 2>/dev/null) != true ]]; then return 0; fi
  # Fade the complete card first; collapsing the body while visible made the
  # centered wallpaper window shrink/jump toward its header on close.
  e update shown=false
  sleep 0.16
  e update session_visible=false body=false armed=""
  for window in $open; do [[ $window == session ]] || e close "$window"; done
  walls_cmd preview-stop
}

case ${1:-} in
  wallpaper|session|close|refresh|prepare)
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/raccon-float-$(id -u).visibility.lock"
    if [[ ${1:-} == prepare ]]; then flock -n 9 || exit 0
    else flock -w 3 9 || exit 1; fi ;;
esac

case ${1:-} in
  refresh)
    sync_theme
    if e ping >/dev/null 2>&1; then e reload; fi
    exit ;;
  close) close; exit ;;
  disarm) e update armed=""; exit ;;
  preview-stop) walls_cmd preview-stop "${2:-}"; exit ;;
  filter)
    [[ ${2:-} =~ ^(all|images|videos)$ ]] || exit 2
    walls_cmd preview-stop
    walls_cmd request "$2"
    exit ;;
  preview|preview-hover)
    [[ ${2:-} =~ ^(all|images|videos)$ && ${3:-} =~ ^[0-9]+$ ]] || exit 2
    walls_cmd "$1" "$2" "$3"
    exit ;;
  page)
    [[ ${2:-} =~ ^(all|images|videos)$ && ${3:-} =~ ^[0-9]+$ ]] || exit 2
    walls_cmd request "$2" "$3"
    exit ;;
  set)
    [[ ${2:-} =~ ^(all|images|videos)$ && ${3:-} =~ ^[0-9]+$ ]] || { echo "raccon-float: bad wallpaper" >&2; exit 2; }
    walls_cmd set "$2" "$3"
    exit ;;
  run)
    action=${2:-}
    [[ $action =~ ^(lock|suspend|logout|reboot|poweroff)$ ]] || { echo "raccon-float: bad action" >&2; exit 2; }
    if [[ $action != lock && $(e get armed) != "$action" ]]; then
      e update armed="$action"; exit
    fi
    close
    case $action in
      lock) exec "$HOME/.local/bin/lock" ;;
      logout)
        [[ ${XDG_SESSION_ID:-} =~ ^[A-Za-z0-9_-]+$ ]] || { echo "raccon-float: unknown session" >&2; exit 1; }
        exec loginctl terminate-session "$XDG_SESSION_ID" ;;
      *) exec systemctl "$action" ;;
    esac ;;
  prepare) name=session ;;
  wallpaper|session) name=$1 ;;
  *) echo "usage: raccon-float wallpaper|session|close|set|run" >&2; exit 2 ;;
esac

if [[ ${1:-} != prepare ]]; then
  # Fast path for resident session card: one IPC update instead of 9 sequential calls.
  if [[ $name == session ]]; then
    if [[ -f "$session_flag" ]]; then
      close; exit
    fi
    if [[ ! -f "$wall_flag" && -f "$session_ready" && $(<"$session_ready") == 1 ]]; then
      if e update armed="" who="$(who_json)" session_visible=true shown=true body=true >/dev/null 2>&1; then
        touch "$session_flag"
        exit 0
      fi
    fi
  elif [[ $name == wallpaper ]]; then
    if [[ -f "$wall_flag" ]]; then
      close; exit
    fi
    if [[ ! -f "$session_flag" && -f "$session_ready" && $(<"$session_ready") == 1 ]]; then
      style=$(grep -oP '^\s*"style"\s*:\s*"\K[\w-]+' "$HOME/.config/desktop-style/current/tokens.json" 2>/dev/null || echo default)
      walls_cmd preview-stop >/dev/null 2>&1 || true
      walls_cmd request all >/dev/null 2>&1 || true
      if e update armed="" shown=true body=true session_visible=false >/dev/null 2>&1 &&
         e open wallpaper --arg style="$style" >/dev/null 2>&1; then
        touch "$wall_flag"
        exit 0
      fi
    fi
  fi
  if [[ $name == session && $(e get session_visible 2>/dev/null) == true ]] ||
     { [[ $name == wallpaper ]] && e active-windows 2>/dev/null | grep -q '^wallpaper:' && [[ $(e get shown) == true ]]; }; then close; exit; fi
  close  # only one card at a time
fi
if [[ -x "$HOME/.local/bin/desktop-menu" ]]; then
  module=$("$HOME/.local/bin/desktop-menu" keyboard-build)
else
  module=$(python3 "$lib/keyboard_build.py")
fi
revision=$(stat -c '%y:%s' "$module" 2>/dev/null || echo 0)
key_stamp="$HOME/.cache/raccon-float/keyboard.loaded"
if [[ $(cat "$key_stamp" 2>/dev/null || true) != "$revision" ]]; then
  e kill >/dev/null 2>&1 || true
fi
if ! e ping >/dev/null 2>&1; then
  rm -f "$session_ready" "$session_flag" "$wall_flag"
  GTK_MODULES="$module" RACCON_FLOAT_KEYS=1 LANGUAGE=en_US:en LC_MESSAGES=en_US.UTF-8 eww -c "$cfg" daemon 9>&- </dev/null &>/dev/null
  e ping >/dev/null
  printf '%s' "$revision" > "$key_stamp"
fi  # detached pipes: the daemon must not hold our stdout
sync_theme
if [[ ${1:-} == prepare ]] && e active-windows | grep -q '^session:'; then
  if [[ -x "$HOME/.local/bin/desktop-menu" ]]; then
    exec "$HOME/.local/bin/desktop-menu" card-wait raccon-float-session.ready
  fi
  exec python3 "$lib/card_wait.py" raccon-float-session.ready
fi
style=$(grep -oP '^\s*"style"\s*:\s*"\K[\w-]+' "$HOME/.config/desktop-style/current/tokens.json" 2>/dev/null || echo default)
if [[ $name == wallpaper ]]; then
  walls_cmd preview-stop
  walls_cmd request all
  e update armed="" shown=false body=true session_visible=false
else
  e update who="$(who_json)" armed="" shown=false body=true session_visible=false
fi
if ! e active-windows | grep -q "^$name:"; then
  if [[ $name == session ]]; then rm -f "$session_ready"; fi
  e open "$name" --arg style="$style"
fi
if [[ ${1:-} == prepare ]]; then
  if [[ -x "$HOME/.local/bin/desktop-menu" ]]; then
    exec "$HOME/.local/bin/desktop-menu" card-wait raccon-float-session.ready
  fi
  exec python3 "$lib/card_wait.py" raccon-float-session.ready
fi
if [[ $name == session ]]; then
  touch "$session_flag"
  e update session_visible=true shown=true body=true
else
  touch "$wall_flag"
  e update shown=true body=true
fi
