#!/bin/sh
menu="$HOME/.local/bin/desktop-menu"
case "${1:-}" in
    wallpaper|session) exec "$menu" ipc toggle "$1" ;;
    close)
        "$menu" ipc close wallpaper
        exec "$menu" ipc close session ;;
    prepare) exec "$menu" prepare ;;
    refresh) exit 0 ;;
    *) echo "usage: raccon-float wallpaper|session|close|prepare" >&2; exit 2 ;;
esac
