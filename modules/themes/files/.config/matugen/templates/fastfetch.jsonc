// Generated by matugen from {{image}} — edit ~/.config/matugen/templates/fastfetch.jsonc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "$HOME/.config/fastfetch/raccoon.txt",
    "color": {
      "1": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "2": "38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}"
    },
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "title": "38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}"
    },
    "key": {
      "width": 3
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "󰣇",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "󰏖"
    },
    {
      "type": "cpu",
      "key": "󰻠",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰍛"
    },
    {
      "type": "disk",
      "key": "󰋊",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "uptime",
      "key": "󰔟"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
