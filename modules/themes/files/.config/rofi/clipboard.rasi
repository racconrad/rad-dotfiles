/* Clipboard history: list with image previews, styled like the waybar dock islands.
   Colors come from matugen (colors.rasi). */
@import "colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
    font:             "Inter 11";
}

window {
    width:            680px;
    location:         center;
    anchor:           center;
    border:           1px;
    border-color:     @outline;
    border-radius:    20px;
    background-color: @bg;
    padding:          16px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, listview, message ];
}

inputbar {
    padding:          10px 14px;
    border-radius:    14px;
    background-color: @bg-alt;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font 13";
}

entry {
    placeholder:       "Search clipboard…";
    placeholder-color: @fg-dim;
}

listview {
    lines:     7;
    columns:   1;
    spacing:   6px;
    scrollbar: false;
    cycle:     true;
}

element {
    padding:       8px 12px;
    spacing:       14px;
    border-radius: 12px;
    border:        2px;
    border-color:  transparent;
    children:      [ element-icon, element-text ];
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    border-color:     @accent;
    background-color: @accent-soft;
}

element-icon {
    size:          80px;
    border-radius: 8px;
}

element-text {
    vertical-align: 0.5;
    font:           "JetBrainsMono Nerd Font 10";
}

message {
    padding:          6px 10px;
    border-radius:    10px;
    background-color: transparent;
}

textbox {
    text-color: @fg-dim;
    font:       "Inter 9";
    horizontal-align: 0.5;
}

@import "@RDOT_HOME@/.config/desktop-style/current/rofi.rasi"
